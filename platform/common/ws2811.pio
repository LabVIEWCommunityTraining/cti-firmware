.program ws2811
.side_set 1

; Driver patches instruction delays at START. Clock is always 16 MHz.
; Defaults: T0H=4, T0L=16, T1H=10, T1L=10 cycles.
; MSB-first, autopull at 24 bits. An empty FIFO stalls OUT with data low.
.wrap_target
bitloop:
    out x, 1             side 0
    jmp !x bit_zero      side 1 [3]
    nop                  side 1 [5]
    nop                  side 0 [6]
    nop                  side 0
    jmp bitloop          side 0
bit_zero:
    nop                  side 0 [12]
    nop                  side 0
    jmp bitloop          side 0
.wrap
